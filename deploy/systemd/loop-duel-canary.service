[Unit]
Description=LOOP live two-wallet DUEL canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/loop/current
EnvironmentFile=/opt/loop/shared/.env.production
Environment=HOME=/root
Environment=PATH=/opt/loop/tools:/root/.acton/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/bash scripts/run-duel-canary-service.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/.acton /root/.config/acton /opt/loop/current/build

[Install]
WantedBy=multi-user.target
